{
  "name": "spectra-vision",
  "version": "2.2.2",
  "private": true,
  "description": "A camera-first computer vision studio: seven on-device vision modes, effects driven by tracking, and a measured performance lab.",
  "author": "Tarang Jammalamadaka",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "setup": "node scripts/setup-assets.mjs",
    "build": "pnpm run setup && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "4.1.0"
  },
  "packageManager": "pnpm@11.8.0"
}
